# Database
DATABASE_URL=postgresql://sdlc_user:sdlc_password@localhost:5432/ai_sdlc_db

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Anthropic / Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (optional, for future support)
OPENAI_API_KEY=sk-...

# Auth
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Redis
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Features
ENABLE_LOCAL_MODEL_MANAGER=true
ENABLE_CLOUD_APIS=true
